# Chiave Anthropic (traduzione con Claude)
ANTHROPIC_API_KEY=
# Chiave ElevenLabs (trascrizione, clonazione vocale, sintesi)
ELEVENLABS_API_KEY=

# Opzionali
PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# ELEVENLABS_STT_MODEL=scribe_v1
# eleven_flash_v2_5 = latenza minima; eleven_multilingual_v2 = massima fedeltà della voce
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Voce usata finché un interlocutore non ha clonato la propria
# ELEVENLABS_FALLBACK_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Segreto per firmare i link audio (facoltativo: se manca viene derivato dalla chiave ElevenLabs)
# TTS_SECRET=

# ---------- Chiamate telefoniche tradotte (Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero Twilio (o tuo numero verificato su Twilio) da cui partono le chiamate, es. +393401234567
TWILIO_PHONE_NUMBER=
# Indirizzo pubblico https del server, raggiungibile da Twilio, es. https://interprete.onrender.com
PUBLIC_URL=
# Codice richiesto dall'app per chiamare: impedisce ad altri di fare chiamate a tue spese
CALL_ACCESS_CODE=
# Durata massima di una chiamata, in minuti
# CALL_MAX_MINUTES=30
